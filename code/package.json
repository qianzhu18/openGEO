{
  "name": "opengeo-engine",
  "version": "0.8.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "opengeo": "tsx src/opengeo/cli.ts",
    "dev": "tsx src/citekeel/server.ts",
    "start": "tsx src/citekeel/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "demo": "tsx src/citekeel/cli.ts demo",
    "case": "tsx src/citekeel/cli.ts",
    "upstream": "cd vendor/niubigeo && tsx src/product/product-server.ts",
    "check:upstream": "npm --prefix vendor/niubigeo ci --no-audit --no-fund && npm --prefix vendor/niubigeo run self-check",
    "test:browser": "playwright test --config playwright.config.ts",
    "browser:check": "tsx src/citekeel/browser/cli.ts check",
    "browser:ask": "tsx src/citekeel/browser/cli.ts ask",
    "browser:batch": "tsx src/citekeel/browser/cli.ts batch",
    "browser:probe": "tsx src/citekeel/browser/cli.ts probe",
    "browser:worker": "tsx src/citekeel/browser/host-worker.ts",
    "browser:login": "tsx src/citekeel/browser/cli.ts login",
    "campaign": "tsx scripts/campaign.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "linkify-it": "^6.1.0",
    "marked": "^18.0.11",
    "nodemailer": "^10.0.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.63.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Traceable GEO delivery workflows, evidence, and reproducible self-improvement cycles"
}
