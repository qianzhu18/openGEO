{
  "name": "opengeo",
  "version": "0.8.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "opengeo": "tsx src/opengeo/cli.ts",
    "dev": "tsx scripts/serve.ts --dev",
    "start": "tsx scripts/serve.ts",
    "build": "npm run build:server && next build",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "demo": "tsx src/workbench/cli.ts demo",
    "case": "tsx src/workbench/cli.ts",
    "upstream": "cd vendor/niubigeo && tsx src/product/product-server.ts",
    "check:upstream": "npm --prefix vendor/niubigeo ci --no-audit --no-fund && npm --prefix vendor/niubigeo run self-check",
    "test:browser": "playwright test --config playwright.config.ts",
    "browser:check": "tsx src/workbench/browser/cli.ts check",
    "browser:ask": "tsx src/workbench/browser/cli.ts ask",
    "browser:batch": "tsx src/workbench/browser/cli.ts batch",
    "mcp": "tsx src/workbench/mcp.ts",
    "browser:probe": "tsx src/workbench/browser/cli.ts probe",
    "browser:worker": "tsx src/workbench/browser/host-worker.ts",
    "browser:login": "tsx src/workbench/browser/cli.ts login",
    "campaign": "tsx scripts/campaign.ts",
    "build:server": "tsc -p tsconfig.backend.json",
    "typecheck": "tsc --noEmit",
    "browser:worker:prepare": "tsx scripts/prepare-browser-worker.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.0",
    "linkify-it": "^6.1.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.0.11",
    "next": "^16.4.6",
    "nodemailer": "^10.0.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Traceable GEO delivery workflows, evidence, and reproducible self-improvement cycles"
}
