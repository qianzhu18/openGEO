{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/workbench/**/*.ts", "src/opengeo/**/*.ts", "scripts/*.ts", "test/*.test.ts"],
  "exclude": ["node_modules", "dist"]
}
