# Optional. Replay and synthetic examples work without keys.
OPENROUTER_API_KEY=
CLORO_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Set the model explicitly for CLI live runs.
CITEKEEL_MODEL=
CITEKEEL_PORT=8847
# Source data and local reports stay here, outside version control.
CITEKEEL_DATA_DIR=data/citekeel
# Default diagnosis: Cloro monitors ChatGPT/Gemini; OpenRouter serves domestic models.
# Store keys only in local .env (gitignored). Web settings last only for the current process.
# Override domestic model IDs only when needed; changes create different protocols.
# OPENGEO_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# OPENGEO_QWEN_MODEL=qwen/qwen3.8-flash
# OPENGEO_SEED_MODEL=bytedance-seed/seed-2-1-turbo
