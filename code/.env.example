# Optional. Replay and synthetic examples work without keys.
OPENROUTER_API_KEY=
CLORO_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Set the model explicitly for CLI live runs.
CITEKEEL_MODEL=
CITEKEEL_PORT=8847
# Optional local Clash HTTP/mixed port. Applied after .env loads; localhost bypasses it.
# OPENGEO_PROXY_URL=http://127.0.0.1:7897
# Source data and local reports stay here, outside version control.
CITEKEEL_DATA_DIR=data/citekeel
# Default diagnosis: OpenRouter serves ChatGPT + domestic models; Cloro monitors Gemini.
# Store keys only in local .env (gitignored). Web settings last only for the current process.
# ChatGPT is a preselected model API fallback, not a ChatGPT web observation.
# Override model IDs only when needed; changes create different protocols.
# OPENGEO_CHATGPT_API_MODEL=openai/gpt-6-luna
# OPENGEO_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# OPENGEO_QWEN_MODEL=qwen/qwen3.8-flash
# OPENGEO_SEED_MODEL=bytedance-seed/seed-2-1-turbo
