# GitHub sync allowlist: keep local documents, publish code only.
/*
!/.gitignore
!/code/

# Markdown stays local, including agent instructions and skills.
*.[mM][dD]
*.[mM][dD][xX]
*.[mM][aA][rR][kK][dD][oO][wW][nN]
**/docs/
**/references/

# Dependencies, generated output, runtime data and credentials.
node_modules
dist/
data/
.env
.env.*
!.env.example
test-results/
playwright-report/
artifacts/
code/vendor/niubigeo/dist/
code/vendor/niubigeo/assets/screenshots/
.DS_Store
*.log

# Local vault state and temporary research captures
.obsidian/
*.har
*.saz
*.pem
*.key
